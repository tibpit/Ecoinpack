# Env vars for local `next dev` (.env.local). For the Workers runtime
# (preview/production), secrets go in .dev.vars / `wrangler secret put`
# and non-secret vars in wrangler.jsonc → "vars".

# ── Anthropic ────────────────────────────────────────────────────────────────
# API key for the analysis model (claude-sonnet-4-6).
# Create at https://platform.claude.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Stripe ───────────────────────────────────────────────────────────────────
# Secret key (test mode: sk_test_..., live: sk_live_...).
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the webhook endpoint pointing to /api/stripe-webhook.
# Local dev: printed by `stripe listen`. Production: shown when you create
# the endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend (delivery email) ──────────────────────────────────────────────────
RESEND_API_KEY=re_...
# Must be a sender on a domain you verified in Resend.
RESEND_FROM_EMAIL="RedPen Profile <results@yourdomain.com>"

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. Used for Stripe redirect URLs and the
# link inside the result email.
NEXT_PUBLIC_APP_URL=http://localhost:3000
